# ==============================================================================
# UNIVERSAL LINKEDIN JOB ALERT BOT - CONFIGURATION TEMPLATE
# ==============================================================================
# Every single knob, title gate, geofence, and tech tag is controlled here.
# Zero Python code edits are required. Simply configure and deploy.

# ------------------------------------------------------------------------------
# 1. BOT IDENTITY & TELEGRAM DESTINATION
# ------------------------------------------------------------------------------
BOT_TITLE="Universal LinkedIn Job Alert Bot"

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Target Telegram Channel or Group ID (must start with -100 for supergroups/channels)
TELEGRAM_CHAT_ID="-100XXXXXXXXXX"

# Optional: Separate channel for recycled/reposted agency requisitions
# (Leave identical to TELEGRAM_CHAT_ID or empty to send all alerts to one channel)
TELEGRAM_FRESH_CHAT_ID="-100XXXXXXXXXX"
TELEGRAM_REPOSTED_CHAT_ID="-100XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. LINKEDIN SCRAPING DISCOVERY PARAMETERS
# ------------------------------------------------------------------------------
# Comma-separated list of query strings passed to LinkedIn search
SEARCH_QUERIES="DevOps Engineer, Cloud Engineer, Site Reliability Engineer, Platform Engineer"

# Pipe-separated list of target regions passed to LinkedIn search
SEARCH_LOCATIONS="United Arab Emirates | Bengaluru, Karnataka, India | India (Remote)"

# LinkedIn lookback window: r10800 = past 3 hours, r86400 = past 24 hours
TIME_FILTER="r10800"

# Maximum age of posting in hours. Drops anything older than this threshold
MAX_HOURS_OLD=6

# Polling interval in seconds between full scan sweeps (900 = 15 minutes)
POLL_INTERVAL_SECONDS=900

# SQLite database file path (persisted across container restarts)
DB_FILE="/app/data/seen_jobs.db"

# Sequential Job ID Delta Threshold (~2.5M IDs ≈ ~4 to 5 days of global postings)
# Flags refreshed requisitions masquerading as new posts
ID_DELTA_REPOST_THRESHOLD=2500000

# ------------------------------------------------------------------------------
# 3. TITLE & SENIORITY GATES (Comma-separated lists)
# ------------------------------------------------------------------------------
# Gate 1: Whitelist (Target job titles. Leave empty to allow all non-blacklisted titles)
GATE1_WHITELIST="devops, sre, site reliability, site reliability engineer, cloud engineer, platform engineer, kubernetes, devsecops, cloud architect, finops, gitops, terraform"

# Gate 2: Blacklist (Drops irrelevant roles, sales, interns, or competing stacks)
GATE2_BLACKLIST="sales, telecaller, intern, internship, recruiter, hr, graphic designer, frontend developer, backend developer, qa engineer, tester"

# Gate 2.25: Seniority Blacklist (Runs BEFORE whitelist; rejects executive/manager traps)
# Leave empty if you are searching for leadership/management roles
SENIORITY_BLACKLIST="director, associate director, assistant director, vp, vice president, avp, head of, principal, staff, manager"

# Gate 2.5: Company Blacklist (Mass job aggregators, ghost recruiters, or spam consultancies)
COMPANY_BLACKLIST="Quik Hire, Quik Hire Staffing, Hire Feed, micro1, Turing, Crossover, Braintrust"

# ------------------------------------------------------------------------------
# 4. LOCATION GEOFENCING & REMOTE PERMISSIONS
# ------------------------------------------------------------------------------
# Allowed Locations: Comma-separated allowed cities/countries.
# If configured, jobs must match at least one term. (Leave empty to allow all locations)
ALLOWED_LOCATIONS="uae, united arab emirates, dubai, abu dhabi, sharjah, bengaluru, bangalore, hyderabad, chennai, kochi, kerala, pune"

# Disallowed Locations: Explicitly rejected countries or states
# (e.g. drop US, UK, Europe if LinkedIn returns cross-border matches)
DISALLOWED_LOCATIONS="united states, usa, united kingdom, uk, canada, australia, germany, france, netherlands, poland, philippines"

# Remote Allowed Regions: Regions where remote/WFH roles are permitted
REMOTE_ALLOWED_REGIONS="india, united arab emirates, uae, remote"

# ------------------------------------------------------------------------------
# 5. JOB DESCRIPTION & SKILL CRAFT VALIDATION (Gate 3)
# ------------------------------------------------------------------------------
# Required JD Keywords: Skills that must appear in the job description.
# Leave empty to skip mandatory skill checking.
REQUIRED_JD_KEYWORDS="kubernetes, terraform, aws, docker, ci/cd, gitops, azure, gcp"
MIN_REQUIRED_JD_MATCHES=1

# Banned JD Keywords: Red flag terms in the description.
# Jobs exceeding MAX_BANNED_JD_MATCHES will be discarded.
BANNED_JD_KEYWORDS="unpaid internship, stipend, commission only, door to door"
MAX_BANNED_JD_MATCHES=1

# ------------------------------------------------------------------------------
# 6. DYNAMIC TECH & SKILL BADGES (Displayed in Telegram Alert)
# ------------------------------------------------------------------------------
# Format: Label:regex_pattern, Label2:regex_pattern2
# The bot scans the title and description to attach matching badges automatically.
TECH_TAGS="Kubernetes:kubernetes|k8s|eks|gke|aks, Terraform:terraform|opentofu|terragrunt, ArgoCD / GitOps:argocd|fluxcd|gitops, AWS:aws|amazon web services, Azure:azure|microsoft azure, GCP:gcp|google cloud, Docker:docker|containerd|helm, FinOps:finops|karpenter|kubecost, DevSecOps:devsecops|trivy|falco|wiz"

# ------------------------------------------------------------------------------
# 7. TELEGRAM MESSAGE & WHATSAPP FORWARDING CUSTOMIZATION
# ------------------------------------------------------------------------------
# Banner label printed in the Telegram alert header
ALERT_ROLE_LABEL="DEVOPS / CLOUD ROLE"
ALERT_HEADER_EMOJI="🟢"

# Enable or disable the One-Tap WhatsApp share snippet (true / false)
WHATSAPP_SHARE_ENABLED="true"

# Optional greeting placed on Line 1 of the WhatsApp share block
# Leave empty for pure English text, or supply your desired greeting
WHATSAPP_GREETING="Assalamu Alaikum bro,"

# Message body placed on Line 2 of the WhatsApp share block
# Supported placeholders: {role}, {company}, {location}, {link}
WHATSAPP_TEMPLATE="Saw this {role} opening at {company} ({location}). Check it out: {link}"
